---
import papers from '../data/driving-papers.json';
import { getTaskSupport, taskNames } from '../lib/task-support.mjs';
import { iconMarkup } from '../lib/facet-icons.mjs';
import { getReview } from '../lib/review.mjs';
import { cardMetadata } from '../lib/card-metadata.mjs';
import { groups, cardTags, filterFacets } from '../lib/explore.mjs';
import { url } from '../lib/site';
import '@fontsource-variable/inter';

const taskDescriptions = {
 detection2d: 'Bounding boxes in image space', detection3d: 'Objects in 3D space',
 semantic: 'Per-pixel or per-point semantic labels', instance: 'Separate instances of each object',
 panoptic: 'Semantic and instance labels together', trajectory: 'Forecast future agent trajectories',
 planning: 'Plan driving actions and motion', tracking: 'Follow objects across time',
 depth: 'Estimate or complete scene depth', flow: 'Estimate pixel motion between frames',
 localization: 'Localization, odometry and mapping',
};
const taskSections = groups.find(group => group.id === 'task')!.options.map(([id, label]) => {
 const matches = filterFacets(papers, [id]);
 const featured = [...matches].sort((a, b) => Number(!!cardMetadata[b.name]?.image) - Number(!!cardMetadata[a.name]?.image) || Number(!!b.name) - Number(!!a.name) || b.year - a.year).slice(0, 5);
 return { id, label, description: taskDescriptions[id], count: matches.length, papers: featured };
});
const exhibitLanes = [0,1,2].map(lane => papers.filter((_,i)=>i%3===lane));
const years = [...new Set(papers.map(p => p.year))].sort((a,b)=>b-a);
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Explore driving datasets by task, sensor, condition and location."/><title>Driving Data</title></head>
<body>

<button id="task-menu-toggle" type="button" aria-controls="task-sidebar" aria-expanded="false">Filters ☰</button>
<aside id="task-sidebar" aria-label="Dataset filters"><div class="sidebar-heading">Explore by<button id="close-task-menu" type="button" aria-label="Close filters">×</button></div>
{groups.filter(group=>group.id!=='location').map(group=><fieldset class="sidebar-filter"><legend>{group.id === 'task' ? 'Task (official)' : group.label}</legend>{group.options.map(([id,label])=><label><input type="checkbox" data-facet={id}/>{['sensors','conditions'].includes(group.id) && <span class="sidebar-facet-icon" set:html={iconMarkup(id)}/>}<span>{label}</span></label>)}</fieldset>)}
<fieldset class="sidebar-filter"><legend>Readiness</legend><label><input type="checkbox" data-facet="py123d"/><span class="sidebar-facet-icon format-supported" set:html={iconMarkup('py123d')}/><span>123D supported</span></label></fieldset>
<div class="location-soon"><span>Location</span><small>Coming soon</small></div>
<p class="filter-help">Matches all selected filters.</p>
</aside>
<dialog id="dataset-cart" aria-labelledby="cart-title">
 <div class="cart-heading"><div><span class="cart-eyebrow">YOUR WORKSPACE</span><h2 id="cart-title">My datasets <span id="collection-count">0</span></h2></div><button id="close-cart" type="button" aria-label="Close dataset cart">×</button></div>
 <p id="selection-hint">Select datasets to compare and plan your setup.</p>
 <div id="cart-coverage"></div>
 <div id="selection-preview" aria-label="Selected datasets"></div>
 <div class="cart-footer"><a id="collection-link" href={url('/?collection=1')}>Compare &amp; prepare <span aria-hidden="true">→</span></a><small>Review labels, splits and download access.</small></div>
</dialog>
<main id="main">
 <div class="search-dock">
 <section class="search-home" aria-label="Dataset search">
  <div class="header-intro"><h1>Shop for driving datasets. <span>Spend less time preparing, more time researching.</span></h1></div>
  <button id="open-cart" class="cart-trigger" type="button" aria-haspopup="dialog" aria-controls="dataset-cart"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3h2l3 12h11l3-9H6M9 20h.01M18 20h.01" stroke-linecap="round" stroke-linejoin="round"/></svg>My datasets <span id="cart-count" aria-live="polite">0</span></button>
  <form id="search-form" hidden><textarea id="query" aria-label="Search" tabindex="-1"></textarea></form>


 </section>
 <div class="pixel-road" aria-hidden="true"><div class="pixel-car-run"><svg class="pixel-car" width="96" height="48" viewBox="0 0 48 24" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
  <path fill="#91a8c5" d="M14 4h20v4h4v4h8v8H2v-8h8V8h4z"/>
  <path fill="#e2ebf4" d="M16 7h7v5H12V10h4zm11 0h5v3h3v2h-8z"/>
  <path fill="#405674" d="M8 17h8v7H8zm24 0h8v7h-8z"/>
 </svg></div></div>
 </div>
 <section class="icon-guide" aria-label="Dataset icon guide">

  <details><summary>Icon guide <span>Sensors, conditions &amp; format</span></summary>
   <div class="icon-guide-content">
   {groups.filter(g=>['sensors','conditions'].includes(g.id)).map(group=><div class="icon-guide-row"><span class="icon-guide-category">{group.label}</span><div>{group.options.map(([id,label])=><button type="button" data-card-facet={id} title={`Filter by ${label}`} aria-label={`Filter by ${label}`}><span set:html={iconMarkup(id)}/><span>{label}</span></button>)}</div></div>)}
   <div class="icon-guide-row"><span class="icon-guide-category">Format</span><div><button type="button" data-card-facet="py123d" title="Filter by 123D supported" aria-label="Filter by 123D supported"><span class="format-supported" set:html={iconMarkup('py123d')}/><span>123D supported</span></button><span class="legend-static"><span set:html={iconMarkup('py123d-not-listed')}/>123D not listed</span></div></div>
   </div>
  </details>
 </section>
 <section class="browse-toolbar" aria-label="Browse datasets"><div class="examples-heading"><h2>Explore datasets <span id="gallery-count" aria-live="polite"></span></h2><label class="dataset-name-search"><span class="sr-only">Search datasets by name</span><input id="dataset-name" type="search" placeholder="Search dataset names…" autocomplete="off"/></label><div class="gallery-actions"><label class="catalog-sort-label">Sort <select id="catalog-sort" aria-label="Sort datasets"><option value="relevance">Default</option><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label><label class="supported-only"><input type="checkbox" data-facet="py123d"/>Show 123D supported only</label><button id="pause-gallery" type="button" aria-pressed="false">Pause motion</button><button id="browse-examples" type="button">View all →</button></div></div></section>
 <div class="active-filter-bar"><div id="selected-facets" hidden><div id="facet-chips" aria-label="Selected choices"></div><button id="clear-facets" type="button">Clear all</button></div>
</div>
 <section id="examples" aria-label="Dataset exhibition"><p id="gallery-empty" hidden>No datasets match these choices. Try removing a filter.</p>
 {exhibitLanes.map((lane,index)=><div class="exhibit-lane" aria-label={`Dataset row ${index+1}`} tabindex="0"><div class="exhibit-track">{lane.map(paper=><article class="example-card" data-paper-id={paper.id}><label class="card-select"><input type="checkbox" data-pick={paper.id} aria-label={`Select ${paper.name || paper.title}`}/><span class="sr-only">Select dataset</span></label>
   <div class="card-preview">
    <span class="preview-empty"><span class="preview-initial">{(paper!.name || paper!.title).slice(0,2)}</span><small>Preview unavailable</small></span>
    {cardMetadata[paper!.name]?.image && <img src={cardMetadata[paper!.name].image.startsWith('/') ? url(cardMetadata[paper!.name].image) : cardMetadata[paper!.name].image} alt={cardMetadata[paper!.name].imageAlt || `${paper!.name} official project preview`} style={{objectPosition: cardMetadata[paper!.name].imagePosition || 'center', transform: `scale(${cardMetadata[paper!.name].imageScale || 1})`, transformOrigin: 'top center'}} loading="lazy" referrerpolicy="no-referrer" />}
    {cardMetadata[paper!.name]?.imageCaption && <span class="preview-caption">{cardMetadata[paper!.name].imageCaption}</span>}
    {cardMetadata[paper!.name]?.image && <a class="image-source" href={cardMetadata[paper!.name].source} target="_blank" rel="noopener noreferrer">Source ↗</a>}
   </div>
   <div class="example-meta"><span>{paper!.year}</span><span>DATASET</span></div>
   <h3><a href={paper!.paper} target="_blank" rel="noopener noreferrer">{paper!.name || 'Unnamed dataset'}</a></h3>
   <div class="card-support"><div class="task-support-list" tabindex="0" aria-label="Task support and evidence">{Object.entries(getTaskSupport(paper.id)).map(([task,info])=><a class={`support-badge ${info.status}`} data-support-task={task} href={info.source} target="_blank" rel="noopener noreferrer" title={`${taskNames[task]}: ${info.scope || ''} ${info.reason}`} aria-label={`${taskNames[task]}: ${info.status === 'official' ? 'Official support' : 'Potential use'}. ${info.scope || ''} ${info.reason} Open evidence.`}>{taskNames[task]} · {info.status === 'official' ? 'Official' : 'Potential'}</a>)}</div></div>
   <div class="card-tags">{groups.filter(group => ['sensors','conditions'].includes(group.id)).map(group => <div class="tag-row"><span class="tag-label">{group.label}</span><div>{(cardTags(paper).find(tags => tags.id === group.id)?.options || []).map(([id,label]) => <button type="button" class="card-tag" data-card-facet={id} title={label} aria-label={`Filter by ${label}`}><span set:html={iconMarkup(id)}/></button>)}{!cardTags(paper).find(tags => tags.id === group.id)?.options.length && <span class="metadata-placeholder" title="Not documented">—</span>}</div></div>)}{getReview(paper.id) && <div class="tag-row format-row"><span class="tag-label">Format</span><div><a class={`card-format-icon ${getReview(paper.id).py123d.status}`} href={getReview(paper.id).py123d.source} target="_blank" rel="noopener noreferrer" aria-label={getReview(paper.id).py123d.status==='supported'?'123D supported: open evidence':'123D not listed: open evidence'} title={(getReview(paper.id).py123d.status==='supported'?'123D supported':'123D not listed')+' — '+getReview(paper.id).py123d.scope}><span set:html={iconMarkup(getReview(paper.id).py123d.status==='supported'?'py123d':'py123d-not-listed')}/></a></div></div>}{!getReview(paper.id) && <div class="tag-row format-row"><span class="tag-label">Format</span><div><span class="metadata-placeholder" title="Not reviewed">—</span></div></div>}</div>
   <a class="example-link" href={paper!.paper} target="_blank" rel="noopener noreferrer">View paper ↗</a>
  </article>)}</div></div>)}
 </section>
 <section id="results" hidden aria-label="Search results">
  <button id="back-to-tasks" type="button">← Back to datasets</button><div class="result-top"><div><div class="eyebrow small-label">THE COLLECTION</div><h2 id="result-count" aria-live="polite"></h2></div><div class="filters"><label><span class="sr-only">Publication year</span><select id="year"><option value="">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label><span class="sr-only">Sort results</span><select id="sort"><option value="relevance">Best match</option><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label></div></div>
  <div id="understood"></div><p class="source-note">Task and condition tags use paper titles and available official metadata. Check each paper for evaluation splits and labels.</p><p class="collection-note">Compare your evaluation candidates and export a preparation plan. Downloading and 123D conversion are not run by this prototype.</p>
  <div id="result-list"></div><div id="empty" hidden><h3>No matching papers yet.</h3><p>Try a broader scenario, a sensor name, or remove the year filter.</p><button id="reset">Browse all papers →</button></div><button id="more" hidden>Show more results <span>↓</span></button>
 </section>
</main>

<script id="papers" type="application/json" set:html={JSON.stringify(papers).replace(/</g,'\\u003c')}></script>
<script>
import { startPixelTraffic } from '../lib/pixel-traffic';
startPixelTraffic(document.querySelector<HTMLElement>('.pixel-road')!);
import { renderReview } from '../lib/review-table';
import { iconMarkup } from '../lib/facet-icons.mjs';
import { getReview } from '../lib/review.mjs';
import { searchPapers } from '../lib/discovery.mjs';
import { labels, filterFacets, cardTags } from '../lib/explore.mjs';
const data=JSON.parse(document.getElementById('papers')!.textContent!);
const $=(id:string)=>document.getElementById(id)!;
const input=$('query') as HTMLTextAreaElement,year=$('year') as HTMLSelectElement,sort=$('sort') as HTMLSelectElement;
let shown=20,current:any[]=[],active=false;
const nameInput=$('dataset-name') as HTMLInputElement;
const normalizeName=(value:string)=>value.normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}]/gu,'');
const selected=new Set<string>();
const saved=new Set<string>();
try{const stored=JSON.parse(localStorage.getItem('driving-data-selection')||'[]');if(Array.isArray(stored))for(const id of stored)if(data.some((r:any)=>r.id===id))saved.add(id);}catch{}
let collectionMode=false, browseAll=false, gridMode=false;
const cart=$('dataset-cart') as HTMLDialogElement;
$('open-cart').addEventListener('click',()=>{closeTaskMenu();cart.showModal();});
$('close-cart').addEventListener('click',()=>cart.close());
cart.addEventListener('click',e=>{if(e.target===cart){const r=cart.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)cart.close();}});
cart.addEventListener('close',()=> $('open-cart').focus());

function syncSaved(){
 document.querySelectorAll<HTMLInputElement>('[data-pick]').forEach(box=>{box.checked=saved.has(box.dataset.pick!);box.closest('article')?.classList.toggle('is-picked',box.checked);});
 $('collection-count').textContent=String(saved.size);
 $('cart-count').textContent=String(saved.size);
 $('open-cart').setAttribute('aria-label',`My datasets, ${saved.size} selected`);
 const tray=$('selection-preview');tray.replaceChildren();
 for(const id of saved){
  const row=data.find((r:any)=>r.id===id);if(!row)continue;
  const item=element('div','','cart-item');
  const original=galleryCards.find(c=>c.dataset.paperId===id)?.querySelector<HTMLImageElement>('.card-preview img');
  if(original){const img=document.createElement('img');img.src=original.src;img.alt='';item.append(img);}else item.append(element('span',(row.name||'DD').slice(0,2),'cart-placeholder'));
  const info=element('div','','cart-item-info');info.append(element('strong',row.name||'Unnamed dataset'));info.append(element('small',String(row.year)+(getReview(id)?' · Metadata reviewed':' · Metadata not reviewed')));item.append(info);
  const remove=element('button','×','cart-remove') as HTMLButtonElement;remove.type='button';remove.setAttribute('aria-label','Remove '+(row.name||'Unnamed dataset')+' from selection');remove.addEventListener('click',()=>{saved.delete(id);syncSaved();if(collectionMode)showCollection();(tray.querySelector('button')||$('close-cart')).focus();});item.append(remove);tray.append(item);
 }
 if(!saved.size){tray.append(element('div','Your collection starts here. Check a dataset card to add it.','cart-empty'));}
 $('selection-hint').textContent=saved.size?`${saved.size} ${saved.size===1?'dataset':'datasets'} selected for your research.`:'Select datasets to compare and plan your setup.';
 const coverage=$('cart-coverage');coverage.replaceChildren();coverage.hidden=!saved.size;
 if(saved.size){
  const reviewed=[...saved].map(id=>getReview(id)).filter(Boolean);
  coverage.append(element('span',`CONDITION COVERAGE · ${reviewed.length}/${saved.size} reviewed`,'coverage-label'));
  const chips=element('div','','coverage-chips');
  for(const [id,label] of [['night','Night'],['rain','Rain'],['snow','Snow'],['fog','Fog']]){const count=reviewed.filter(r=>r.facets.includes(id)).length;chips.append(element('span',`${label} ${count}`));}
  coverage.append(chips,element('small','Counts use reviewed metadata only. Zero means not confirmed in your selection.'));
 }
 $('collection-link').setAttribute('aria-disabled',String(!saved.size));
 $('collection-link').tabIndex=saved.size?0:-1;
 try{localStorage.setItem('driving-data-selection',JSON.stringify([...saved]));}catch{}
}
$('collection-link').addEventListener('click',e=>{if(!saved.size)e.preventDefault();});

function showCollection(){clearTimeout(filterTransition);collectionMode=true;active=true;document.body.classList.add('searching','collection-view');$('examples').hidden=true;$('results').hidden=false;current=data.filter((r:any)=>saved.has(r.id)).map((r:any)=>({...r,matched:[]}));$('result-count').textContent=`Compare your datasets · ${current.length}`;$('understood').replaceChildren();$('empty').hidden=!!current.length;$('empty').querySelector('h3')!.textContent='Start your research collection.';$('empty').querySelector('p')!.textContent='Choose a task, explore its datasets, and check the ones you want to compare for your research.';renderRows();syncSaved();}
document.addEventListener('change',e=>{const box=e.target;if(!(box instanceof HTMLInputElement)||!box.dataset.pick)return;box.checked?saved.add(box.dataset.pick):saved.delete(box.dataset.pick);syncSaved();if(collectionMode)showCollection();});

function element(tag:string,text:string,cls=''){const el=document.createElement(tag);el.textContent=text;if(cls)el.className=cls;return el;}
let filterTransition:ReturnType<typeof setTimeout>;
function render(){
 collectionMode=false;active=false;document.body.classList.remove('collection-view','searching');
 gridMode=selected.size>0||browseAll||!!nameInput.value.trim();
 ($('catalog-sort') as HTMLSelectElement).value=sort.value;
 current=filterFacets(searchPapers(data,'',{year:year.value,sort:sort.value}).results,[...selected]).filter((r:any)=>normalizeName(r.name||'').includes(normalizeName(nameInput.value)));syncFacets();
 $('results').hidden=true;$('examples').hidden=false;
 const params=new URLSearchParams();if(nameInput.value.trim())params.set('name',nameInput.value.trim());if(selected.size)params.set('facets',[...selected].join(','));if(browseAll)params.set('browse','1');if(sort.value!=='relevance')params.set('sort',sort.value);history.replaceState(null,'',location.pathname+(params.size?'?'+params.toString():''));
 const gallery=$('examples');clearTimeout(filterTransition);gallery.classList.add('filter-changing');
 filterTransition=setTimeout(()=>{
 document.body.classList.toggle('catalog-grid',gridMode);
 const byId=new Map(galleryCards.map(card=>[card.dataset.paperId,card]));
 const ids=new Set(current.map(r=>r.id));
 const cards=gridMode?current.map(r=>byId.get(r.id)).filter(Boolean):galleryCards.filter(card=>ids.has(card.dataset.paperId));
 lanes.forEach((lane,index)=>{const track=lane.firstElementChild!;track.replaceChildren(...(gridMode?(index===0?cards:[]):cards.filter((_,i)=>i%lanes.length===index)));lane.hidden=!track.children.length;lane.scrollLeft=0;});
 for(const card of cards){const badges=card.querySelector('.task-support-list');if(badges){const ordered=[...badges.children].sort((a,b)=>Number(selected.has((b as HTMLElement).dataset.supportTask!))-Number(selected.has((a as HTMLElement).dataset.supportTask!)));badges.append(...ordered);badges.scrollLeft=0;}}
 motionRemainders.clear();
 $('gallery-empty').hidden=cards.length>0;$('gallery-count').textContent=gridMode?`${cards.length} matching datasets`:'';syncSaved();gallery.classList.remove('filter-changing');
 },motionPreference.matches?0:140);
}

function renderRows(){
 if(collectionMode){renderReview($('result-list'),current);$('more').hidden=true;return;}
 const list=$('result-list');list.replaceChildren();
 for(const r of current.slice(0,shown)){
  const card=element('article','','result');const pick=document.createElement('input');pick.type='checkbox';pick.dataset.pick=r.id;pick.checked=saved.has(r.id);pick.setAttribute('aria-label','Select '+(r.name||r.title));card.classList.toggle('is-picked',pick.checked);card.append(pick);const info=element('div',String(r.year),'result-year');card.append(info);
  const body=element('div','','result-body');const title=element('a',r.name||'Unnamed dataset','result-name') as HTMLAnchorElement;title.href=r.paper;title.target='_blank';title.rel='noopener noreferrer';body.append(title);

  const meta=element('div','','result-meta');if(r.matched.length){meta.append(element('span',r.complete?'Matches your search':'Partial match',r.complete?'match-label':'partial-label'));for(const t of r.matched)meta.append(element('span',t));}else meta.append(element('span','Dataset paper'));
  const tags=element('div','','card-tags');
  for(const group of cardTags(r)){const row=element('div','','tag-row');row.append(element('span',group.label,'tag-label'));const options=element('div','');for(const [id,label] of group.options){const button=element('button','','card-tag') as HTMLButtonElement;button.type='button';button.innerHTML=iconMarkup(id);button.title=label;button.dataset.cardFacet=id;button.setAttribute('aria-label','Filter by '+label);options.append(button);}row.append(options);tags.append(row);}body.append(tags);
  body.append(meta);card.append(body);const link=element('a','↗','paper-link') as HTMLAnchorElement;link.href=r.paper;link.target='_blank';link.rel='noopener noreferrer';link.setAttribute('aria-label',`Open paper: ${r.name||r.title}`);card.append(link);list.append(card);
 }
 $('more').hidden=current.length<=shown;
}
function search(){clearTimeout(timer);shown=20;render();}
$('search-form').addEventListener('submit',e=>{e.preventDefault();search();});
input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();search();}if(e.key==='Escape'){input.value='';input.focus();}});
let timer:ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{if(active){clearTimeout(timer);timer=setTimeout(search,180);}});
document.querySelectorAll<HTMLButtonElement>('[data-query]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.query!;search();}));
function browse(e?:Event){e?.preventDefault();browseAll=true;selected.clear();nameInput.value='';input.value='';year.value='';sort.value='relevance';search();}
$('reset').addEventListener('click',browse);
$('browse-examples').addEventListener('click',browse);
document.querySelectorAll<HTMLButtonElement>('[data-task-browse]').forEach(button=>button.addEventListener('click',()=>{selected.clear();selected.add(button.dataset.taskBrowse!);input.value='';year.value='';sort.value='relevance';search();window.scrollTo({top:0,behavior:'smooth'});}));
$('back-to-tasks').addEventListener('click',()=>{browseAll=false;clearTimeout(timer);selected.clear();input.value='';year.value='';sort.value='relevance';active=false;collectionMode=false;document.body.classList.remove('collection-view');syncFacets();$('results').hidden=true;$('examples').hidden=false;document.body.classList.remove('searching');history.replaceState(null,'',location.pathname);render();window.scrollTo({top:0,behavior:'smooth'});});
function setTaskOpen(id:string,open:boolean){const toggle=document.querySelector<HTMLButtonElement>(`[data-task-toggle="${id}"]`)!;toggle.setAttribute('aria-expanded',String(open));const content=$('cards-'+id);content.classList.toggle('collapsed',!open);content.inert=!open;}
document.querySelectorAll<HTMLButtonElement>('[data-task-toggle]').forEach(b=>b.addEventListener('click',()=>setTaskOpen(b.dataset.taskToggle!,b.getAttribute('aria-expanded')!=='true')));
const mobileMenu=matchMedia('(max-width:850px)');function syncMenuAccess(){$('task-sidebar').inert=mobileMenu.matches&&!$('task-sidebar').classList.contains('menu-open');}mobileMenu.addEventListener('change',syncMenuAccess);syncMenuAccess();
function closeTaskMenu(){$('task-sidebar').classList.remove('menu-open');syncMenuAccess();$('task-menu-toggle').setAttribute('aria-expanded','false');}
$('task-menu-toggle').addEventListener('click',()=>{const open=$('task-sidebar').classList.toggle('menu-open');$('task-menu-toggle').setAttribute('aria-expanded',String(open));syncMenuAccess();if(open)document.querySelector<HTMLInputElement>('[data-facet]')?.focus();});
$('close-task-menu').addEventListener('click',()=>{closeTaskMenu();$('task-menu-toggle').focus();});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeTaskMenu();}});
document.querySelectorAll<HTMLAnchorElement>('[data-task-jump]').forEach(link=>link.addEventListener('click',e=>{e.preventDefault();const id=link.dataset.taskJump!;if(active)$('back-to-tasks').click();setTaskOpen(id,true);closeTaskMenu();history.replaceState(null,'',location.pathname+'#task-'+id);requestAnimationFrame(()=>{const top=$('task-'+id).getBoundingClientRect().top+window.scrollY-document.querySelector('.search-dock')!.getBoundingClientRect().height-20;window.scrollTo({top,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});}));
const revealObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('revealed');revealObserver.unobserve(entry.target);}}),{threshold:0.06});document.querySelectorAll('[data-reveal]').forEach(card=>revealObserver.observe(card));
const sectionObserver=new IntersectionObserver(entries=>{const entry=entries.find(e=>e.isIntersecting);if(entry){document.querySelectorAll('[data-task-jump]').forEach(link=>{if(link.getAttribute('href')==='#'+entry.target.id)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});}},{rootMargin:'-35% 0px -45% 0px'});document.querySelectorAll('.task-section').forEach(section=>sectionObserver.observe(section));
const dockObserver=new ResizeObserver(([entry])=>document.documentElement.style.setProperty('--dock-height',entry.target.getBoundingClientRect().height+'px'));dockObserver.observe(document.querySelector('.search-dock')!);

year.addEventListener('change',search);sort.addEventListener('change',search);$('more').addEventListener('click',()=>{shown+=20;renderRows();});

function syncFacets(){
 document.querySelectorAll<HTMLInputElement>('[data-facet]').forEach(b=>b.checked=selected.has(b.dataset.facet!));
 const chips=$('facet-chips');chips.replaceChildren();
 for(const id of selected){const b=element('button',labels[id]+' ×','selected-chip') as HTMLButtonElement;b.type='button';b.setAttribute('aria-label','Remove '+labels[id]);b.addEventListener('click',()=>{selected.delete(id);search();});chips.append(b);}
 $('selected-facets').hidden=!selected.size;
}
document.querySelectorAll<HTMLButtonElement>('[data-group]').forEach(button=>button.addEventListener('click',()=>{
 const open=button.getAttribute('aria-expanded')!=='true';
 document.querySelectorAll<HTMLButtonElement>('[data-group]').forEach(b=>b.setAttribute('aria-expanded',String(open&&b===button)));
 document.querySelectorAll<HTMLElement>('[data-panel]').forEach(p=>{const show=open&&p.dataset.panel===button.dataset.group;const wasHidden=p.hidden;p.getAnimations().forEach(a=>a.cancel());if(show){p.hidden=false;p.animate([{opacity:0,transform:'translateY(-6px)'},{opacity:1,transform:'translateY(0)'}],{duration:matchMedia('(prefers-reduced-motion: reduce)').matches?0:180});}else if(!wasHidden){const animation=p.animate([{opacity:1},{opacity:0}],{duration:matchMedia('(prefers-reduced-motion: reduce)').matches?0:140});animation.onfinish=()=>{p.hidden=true;};}});
}));
document.querySelectorAll<HTMLInputElement>('[data-facet]').forEach(box=>box.addEventListener('change',()=>{const id=box.dataset.facet!;box.checked?selected.add(id):selected.delete(id);search();}));
document.addEventListener('click',e=>{const button=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-card-facet]');if(!button)return;selected.add(button.dataset.cardFacet!);search();window.scrollTo({top:0,behavior:'smooth'});});
document.querySelectorAll<HTMLImageElement>('.card-preview img').forEach(img=>{const fallback=()=>{img.hidden=true;img.parentElement!.querySelector('.image-source')?.remove();};img.addEventListener('error',fallback);if(img.complete&&!img.naturalWidth)fallback();});
$('clear-facets').addEventListener('click',()=>{selected.clear();search();});
const motionPreference=matchMedia('(prefers-reduced-motion: reduce)');let paused=motionPreference.matches;
const lanes=[...document.querySelectorAll<HTMLElement>('.exhibit-lane')];
for(const lane of lanes){const track=lane.firstElementChild!;const cards=[...track.children];for(let i=cards.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[cards[i],cards[j]]=[cards[j],cards[i]];}track.append(...cards);}
const galleryCards=lanes.flatMap(lane=>[...lane.querySelectorAll<HTMLElement>('.example-card')]);
function syncMotion(){const button=$('pause-gallery');button.setAttribute('aria-pressed',String(paused));button.textContent=paused?'Resume motion':'Pause motion';}syncMotion();
$('pause-gallery').addEventListener('click',()=>{paused=!paused;syncMotion();});motionPreference.addEventListener('change',()=>{paused=motionPreference.matches;syncMotion();});
const motionRemainders=new Map<HTMLElement,number>();let lastFrame=0;let galleryFrame:number;
function moveGallery(now:number){const delta=Math.min((now-lastFrame)/1000,0.05);lastFrame=now;if(!paused&&!active&&!gridMode&&!cart.open&&!document.hidden){for(const [index,lane] of lanes.entries()){if(lane.matches(':hover')||lane.contains(document.activeElement))continue;const advance=(motionRemainders.get(lane)||0)+delta*(19+index*3);const pixels=Math.floor(advance);motionRemainders.set(lane,advance-pixels);lane.scrollLeft+=pixels;const track=lane.firstElementChild!;const first=track.firstElementChild as HTMLElement;if(!first||lane.scrollWidth<=lane.clientWidth)continue;const step=first.getBoundingClientRect().width+parseFloat(getComputedStyle(track).gap || '12');if(lane.scrollLeft>=step){track.append(first);lane.scrollLeft-=step;}}}galleryFrame=requestAnimationFrame(moveGallery);}galleryFrame=requestAnimationFrame(moveGallery);window.addEventListener('pagehide',()=>cancelAnimationFrame(galleryFrame));
nameInput.addEventListener('input',()=>search());
const params=new URLSearchParams(location.search);nameInput.value=params.get('name')||'';browseAll=params.has('browse');($('catalog-sort') as HTMLSelectElement).value=params.get('sort')||'relevance';
$('catalog-sort').addEventListener('change',()=>{sort.value=($('catalog-sort') as HTMLSelectElement).value;browseAll=true;search();});
const retiredFacets=new Set(['reviewed','india','china','korea','japan','germany','usa','africa']);
for(const id of (params.get('facets')||'').split(','))if(Object.hasOwn(labels,id)&&!retiredFacets.has(id))selected.add(id);
syncSaved();
if(params.has('collection'))showCollection();
else if(params.has('name')||params.has('q')||params.has('browse')||params.has('year')||selected.size){input.value='';year.value=params.get('year')||'';sort.value=params.get('sort')||'relevance';search();}
</script>
